{"help": "https://data.wprdc.org/api/3/action/help_show?name=package_show", "success": true, "result": {"access_level_comment": "PennDOT does not permit making the date of the crash publicly available. That field has been omitted, although month and day of the week are still included. License plate numbers and emergency dispatch times have also been removed.", "author": null, "author_email": null, "creator_user_id": "e63c0b33-2e9d-4576-9f94-fa15c40a0d55", "data_notes": "This data was provided by PennDOT and will be updated annually, after PennDOT posts the new data.\r\nThe data dictionary was updated on 6/10/16 to correct the coding for the Lane Closure Direction field.\r\nThe 2015 data was updated on 6/23/16 to remove duplicate records.\r\nNOTE: The 2017 schema differs from all previous ones by the addition of two new fields: TOT_INJ_COUNT and  SCHOOL_BUS_UNIT. Also, the source data stopped providing the  ACCESS_CTRL and ADJ_RDWY_SEQ fields beginning with 2017 data and the  LOCAL_ROAD field beginning with 2018 data. We are keeping these columns in the schema for the 2017/2018/future/cumulative tables for backward compatibility, but the values will all be nulls for the affected years. For the 2019 data, PennDOT stopped publishing MOD_INJ_COUNT (which we are keeping as a field, but the values will all be nulls) and MAJ_INJ_COUNT (which we are populating with the values from the new similar field SUSPECTED_SERIOUS).", "data_steward_email": "pcithelp@pa.gov ", "data_steward_name": "", "frequency_data_change": "Daily", "frequency_publishing": "Annually", "geographic_unit": "Latitude/Longitude", "id": "3130f583-9499-472b-bb5a-f63a6ff6059a", "isopen": true, "license_id": "cc-zero", "license_title": "Creative Commons CCZero", "license_url": "http://www.opendefinition.org/licenses/cc-zero", "maintainer": null, "maintainer_email": null, "metadata_created": "2023-05-21T13:41:56.642648", "metadata_modified": "2026-09-11T19:30:39.265263", "name": "allegheny-county-crash-data", "notes": "Contains locations and information about every crash incident reported to the police in Allegheny County from 2004 to 2024. Fields include injury severity, fatalities, information about the vehicles involved, location information, and factors that may have contributed to the crash. Data is provided by PennDOT and is subject to PennDOT's data privacy restrictions, which are noted in the metadata information section below.\r\n\r\n<!--The map below shows car crashes in Allegheny County during 2016, with the color indicating whether it was a rear end collision or not.-->", "num_resources": 30, "num_tags": 15, "organization": {"id": "f6dcf8fb-2051-4226-8c74-de9fbc699684", "name": "allegheny-county", "title": "Allegheny County", "type": "organization", "description": "Allegheny County, in the heart of southwestern Pennsylvania, encompasses 130 municipalities; its county seat is the City of Pittsburgh. With a land area of 745 square miles, the county is home to approximately 1.3 million residents. \r\n\r\nAllegheny County government operates under a Home Rule Charter that went into effect on January 1, 2000, providing for an elected County Executive and 15-member County Council. Other elected offices include Controller, District Attorney, Sheriff and Treasurer.\r\n\r\nWith an annual combined operating and capital budget of $1.8 billion, the county administers human services programs, provides emergency services, protects and promotes the health of county residents, promotes economic development, participates in the administration of justice and the conduct of elections, and maintains parks, roads and bridges.\r\n\r\nAllegheny County's official web site is [https://www.alleghenycounty.us/](https://www.alleghenycounty.us/).", "image_url": "2015-10-09-175030.244320CountySeal189x189pixels.jpg", "created": "2023-05-21T09:12:43.335015", "is_organization": true, "approval_status": "approved", "state": "active"}, "owner_org": "f6dcf8fb-2051-4226-8c74-de9fbc699684", "private": false, "related_documents": "", "state": "active", "temporal_coverage": "2004-01-01/2024-12-31", "title": "Allegheny County Crash Data", "type": "dataset", "url": null, "version": null, "groups": [{"description": "", "display_name": "Transportation", "id": "0f962c7b-baa3-483b-93e3-539118d0213c", "image_display_url": "https://data.wprdc.org/uploads/group/2015-10-06-160306.671129transportation.png", "name": "transportation", "title": "Transportation"}], "resources": [{"cache_last_updated": null, "cache_url": null, "created": "2016-06-11T16:49:48.986957", "dataspatial_fields_definition": "", "dataspatial_geom_link": "", "dataspatial_geom_resource": "", "dataspatial_latitude_field": "", "dataspatial_longitude_field": "", "dataspatial_wkt_field": "", "datastore_active": true, "description": "To download this data, use this link: https://tools.wprdc.org/downstream/2c13021f-74a9-4289-a1e5-fe0472c89881\r\n\r\nThis is a combination of all the available crash data for Allegheny County (crashes from 2004 to 2024 inclusive). \r\n\r\nThere are a few years with slight differences in records because of additions and subtractions of fields published by PennDOT. See the \"Data notes\" field on the WPRDC dataset landing page,\r\nhttps://data.wprdc.org/dataset/allegheny-county-crash-data\r\nfor more details.\r\n\r\nYou can also download CSVs for each individual year.", "format": "CSV", "hash": "350b95f29d87055d5481f936705c70ff", "id": "2c13021f-74a9-4289-a1e5-fe0472c89881", "last_modified": "2025-06-30T10:18:41.809900", "metadata_modified": "2025-06-30T14:19:26.394039", "mimetype": null, "mimetype_inner": null, "name": "Cumulative Crash Data", "package_id": "3130f583-9499-472b-bb5a-f63a6ff6059a", "position": 0, "resource_type": null, "size": null, "state": "active", "url": "https://data.wprdc.org/datastore/dump/2c13021f-74a9-4289-a1e5-fe0472c89881", "url_type": "", "tracking_summary": {"total": 0, "recent": 0}}, {"cache_last_updated": null, "cache_url": null, "created": "2018-05-02T11:23:22.269419", "datastore_active": false, "description": "A demonstration Jupyter notebook that shows how to load and manipulate the crash data using the CKAN API, using the Pandas library, and using SQL queries.\r\n\r\nTo launch this notebook in your browser, follow this link: https://mybinder.org/v2/gh/WPRDC/Jupyter-notebooks-by-dataset/master\r\n\r\nand then click on the Crash-Data-Analysis notebook.", "format": "HTML", "hash": "", "id": "6c8d19a1-e01d-4010-a0cb-a7b31a59eeb7", "last_modified": null, "metadata_modified": "2023-05-21T13:41:56.585748", "mimetype": "text/html", "mimetype_inner": null, "name": "Jupyter notebook for analyzing crash data", "package_id": "3130f583-9499-472b-bb5a-f63a6ff6059a", "position": 1, "resource_type": null, "revision_id": "48bc9b5c-a3e4-496e-b01b-1546139e5ded", "size": null, "state": "active", "url": "https://github.com/WPRDC/Jupyter-notebooks-by-dataset/blob/master/Crash-Data-Analysis.ipynb", "url_type": null, "tracking_summary": {"total": 0, "recent": 0}}, {"cache_last_updated": null, "cache_url": null, "created": "2016-06-15T13:04:19.313054", "datastore_active": false, "description": "PennDOT produced a crash data primer that includes more details about what is in the crash data, how crashes are reported, and how they're geocoded.", "format": "PDF", "hash": "", "id": "c884d6da-588d-45ec-b029-8aaec8018500", "last_modified": "2016-06-15T17:04:19.221757", "metadata_modified": "2023-05-21T13:41:56.587062", "mimetype": "application/pdf", "mimetype_inner": null, "name": "Crash Data Primer ", "package_id": "3130f583-9499-472b-bb5a-f63a6ff6059a", "position": 2, "resource_type": null, "revision_id": "39bfe873-7bb0-42b9-b04d-39a87a8da10b", "size": null, "state": "active", "url": "https://data.wprdc.org/dataset/3130f583-9499-472b-bb5a-f63a6ff6059a/resource/c884d6da-588d-45ec-b029-8aaec8018500/download/database-primer-4-15.pdf", "url_type": "upload", "tracking_summary": {"total": 0, "recent": 0}}, {"cache_last_updated": null, "cache_url": null, "created": "2020-10-29T15:52:15.213680", "dataspatial_fields_definition": "", "dataspatial_geom_link": "", "dataspatial_geom_resource": "", "dataspatial_latitude_field": "", "dataspatial_longitude_field": "", "dataspatial_wkt_field": "", "datastore_active": false, "description": "ArcGIS Tool for downloading Crash data for all of Pennsylvania. (This resource previously pointed to https://pennshare.maps.arcgis.com/apps/webappviewer/index.html?id=8fdbf046e36e41649bbfd9d7dd7c7e7e\r\n)", "format": "HTML", "hash": "", "id": "ac8db9a7-2dd3-4fca-a411-519c928ad119", "last_modified": null, "metadata_modified": "2025-07-07T19:25:29.277464", "mimetype": null, "mimetype_inner": null, "name": "PennDOT Crash Download Map", "package_id": "3130f583-9499-472b-bb5a-f63a6ff6059a", "position": 3, "resource_type": null, "size": null, "state": "active", "url": "https://experience.arcgis.com/experience/51809b06e7b140208a4ed6fbad964990", "url_type": "", "tracking_summary": {"total": 0, "recent": 0}}, {"cache_last_updated": null, "cache_url": null, "created": "2024-01-25T18:47:26.008157", "datastore_active": false, "description": "This dashboard displays auto crash incidents reported to the police in Allegheny County between 2018 and 2022. The data showcased is sourced from PennDOT\u2019s Pennsylvania Crash Information Tool. The dashboard enables users to gain insights into crash data and allows for the exploration of related factors such as trends over time, weather and road conditions, involvement of impaired drivers, precipitating traffic violations, and crash locations, among others. The data is visualized through various charts, graphs, tables, and interactive maps.", "format": "HTML", "hash": "", "id": "fdb4ddb4-e692-4db9-9047-729140378389", "last_modified": null, "metadata_modified": "2024-01-25T18:48:09.187586", "mimetype": null, "mimetype_inner": null, "name": "Allegheny County Crash Dashboard", "package_id": "3130f583-9499-472b-bb5a-f63a6ff6059a", "position": 4, "resou