# ==============================================================================
# EDAgent configuration template. Copy to backend/.env (names only: no real secrets here).
# Never commit a real .env. Secrets are read server-side and are never returned by the API.
# ==============================================================================

# --- Application -------------------------------------------------------------
ENVIRONMENT=development            # "production" refuses to start with the placeholder SECRET_KEY
DEBUG=false
APP_NAME=EDAgent
API_V1_STR=/api/v1
SECRET_KEY=                        # REQUIRED in production: long random string used to sign login tokens
ACCESS_TOKEN_EXPIRE_MINUTES=720
ALLOW_REGISTRATION=true
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
HOST=127.0.0.1
PORT=8000

# --- Database ----------------------------------------------------------------
# SQLite for local use; PostgreSQL for production (postgresql+asyncpg://user:pass@host:5432/edagent)
DATABASE_URL=sqlite+aiosqlite:///./edagent.db

# --- Storage -----------------------------------------------------------------
STORAGE_BACKEND=local              # only "local" is implemented
LOCAL_STORAGE_PATH=./data/uploads
EXPORTS_STORAGE_PATH=./data/exports
SAMPLES_PATH=./data/samples
MAX_UPLOAD_SIZE_MB=200
EXPORT_RETENTION_HOURS=72

# --- AI provider (optional) --------------------------------------------------
# Without a valid provider and key, AI chat is disabled; analysis still works.
# Provider requests send dataset structure, summary statistics and some sanitized
# sample values to the selected service. Keep this file and API keys private.
#
# Google Gemini (uses Google's OpenAI-compatible endpoint):
#   LLM_PROVIDER=openai
#   LLM_MODEL=gemini-3.8-flash  # or another compatible model available to you
#   LLM_API_KEY=<your Google AI Studio Gemini API key>
#   LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
#
# OpenAI: use LLM_PROVIDER=openai, an OpenAI model and key, and an empty base URL.
# Anthropic: use LLM_PROVIDER=anthropic, an Anthropic model and key, and an empty base URL.
# Other OpenAI-compatible services: use LLM_PROVIDER=openai and their model, key,
# and base URL. Change the key whenever you change providers. Restart the backend
# after editing this file. Set LLM_PROVIDER=mock to disable AI chat.
LLM_PROVIDER=mock
LLM_MODEL=gpt-4o
LLM_API_KEY=
LLM_BASE_URL=
LLM_MAX_TOKENS=2048
LLM_TEMPERATURE=0.1
LLM_TIMEOUT_SECONDS=45
LLM_MAX_CONTEXT_CHARS=12000

# --- Limits and performance --------------------------------------------------
MAX_DATASETS_PER_USER=50
MAX_CONCURRENT_JOBS_PER_USER=2
MAX_CONCURRENT_ANALYSES=4
JOB_TIMEOUT_SECONDS=300
ANALYSIS_TIMEOUT_SECONDS=60
MAX_RESULT_ROWS=500
MAX_EXPORT_ROWS=200000
MAX_MODELLING_ROWS=50000
DEFAULT_SAMPLE_SIZE=10000

# --- Rate limits (per minute, in-process; 0 disables) -------------------------
RATE_LIMIT_PER_MINUTE=240
AUTH_RATE_LIMIT_PER_MINUTE=20
ANALYSIS_RATE_LIMIT_PER_MINUTE=60

# --- URL import (SSRF protected) ---------------------------------------------
PREVENT_SSRF=true
URL_IMPORT_MAX_MB=50
URL_IMPORT_TIMEOUT_SECONDS=30
URL_IMPORT_MAX_REDIRECTS=3

# --- Frontend (frontend/.env) ------------------------------------------------
# VITE_API_BASE_URL=http://localhost:8000/api/v1   # omit when using the Vite dev proxy
