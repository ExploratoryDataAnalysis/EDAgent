# EDAgent .gitignore

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/
venv/
.venv/
ENV/

# Node & Frontend
node_modules/
*.tsbuildinfo
dist/
dist-ssr/
*.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Environment and Secrets
.env
.env.*.local
*.pem
*.key

# Data & Local Storage (never commit uploaded datasets or generated reports)
**/data/uploads/*
!**/data/uploads/.gitkeep
**/data/exports/*
!**/data/exports/.gitkeep
!**/data/exports/models
!**/data/exports/models/**
data/parquet/*
!data/parquet/.gitkeep
*.duckdb
*.db
*.sqlite
*.sqlite3
*.db-wal
*.db-shm
*.sqlite-wal
*.sqlite-shm
*.sqlite3-wal
*.sqlite3-shm

# IDE & Editor
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# Celery & Redis
celerybeat-schedule
celerybeat.pid

# Local research inputs and isolated reproduction runs
/data/raw/
/.repro/
